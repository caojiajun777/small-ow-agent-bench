+    async def _verify_static_no_network(self) -> None:
+        """Fail closed unless Docker actually created the isolated main container.
+
+        The host-side record is not mounted into the agent or verifier. Agent
+        and separate-verifier session IDs produce distinct evidence files.
+        """
+        evidence: dict[str, object] = {
+            "schema_version": 1,
+            "isolation": "docker-network-none",
+            "session_id": self.session_id,
+            "container_id": None,
+            "startup_network_policy": self.network_policy.model_dump(mode="json"),
+            "phase_network_policies": [
+                policy.model_dump(mode="json")
+                for policy in self._phase_network_policies
+            ],
+            "network_mode": None,
+            "image": None,
+            "image_id": None,
+            "verified": False,
+        }
+        try:
+            result = await self._run_docker_compose_command(
+                ["ps", "--all", "--quiet", MAIN_SERVICE_NAME], check=True
+            )
+            container_id = (result.stdout or "").strip()
+            if not re.fullmatch(r"[0-9a-f]{64}", container_id):
+                raise RuntimeError(
+                    "Static Docker no-network requires exactly one main container ID."
+                )
+            evidence["container_id"] = container_id
+            proc = await asyncio.create_subprocess_exec(
+                "docker",
+                "inspect",
+                "--type",
+                "container",
+                "--format",
+                '{"network_mode":{{json .HostConfig.NetworkMode}},'
+                '"image":{{json .Config.Image}},"image_id":{{json .Image}}}',
+                container_id,
+                stdout=asyncio.subprocess.PIPE,
+                stderr=asyncio.subprocess.PIPE,
+            )
+            try:
+                stdout, _ = await asyncio.wait_for(proc.communicate(), timeout=10)
+            except BaseException:
+                if proc.returncode is None:
+                    proc.kill()
+                    await proc.wait()
+                raise
+            inspected = json.loads(stdout.decode("utf-8"))
+            if not isinstance(inspected, dict):
+                raise RuntimeError("Docker returned an invalid network inspection.")
+            for field in ("network_mode", "image", "image_id"):
+                evidence[field] = inspected.get(field)
+            if (
+                proc.returncode != 0
+                or inspected.get("network_mode") != "none"
+                or not isinstance(inspected.get("image"), str)
+                or not inspected["image"]
+                or not re.fullmatch(
+                    r"sha256:[0-9a-f]{64}", inspected.get("image_id", "")
+                )
+            ):
+                raise RuntimeError(
+                    "Static Docker no-network was not enforced by the running "
+                    "container (HostConfig.NetworkMode must be 'none')."
+                )
+            evidence["verified"] = True
+        finally:
+            directory = self.trial_paths.trial_dir / "environment"
+            directory.mkdir(parents=True, exist_ok=True)
+            path = directory / (
+                "static-network-"
+                + _sanitize_docker_compose_project_name(self.session_id)
+                + ".json"
+            )
+            path.write_text(json.dumps(evidence, indent=2) + "\n", encoding="utf-8")
