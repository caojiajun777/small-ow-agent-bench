+class TestDockerStaticNoNetwork:
+    """A missing nftables feature must not require weakening deny-all tasks."""
+
+    @staticmethod
+    def _make_environment(
+        temp_dir,
+        *,
+        startup=NetworkMode.NO_NETWORK,
+        phases=(),
+        task_compose=False,
+        extra_compose=False,
+        task_os="linux",
+    ):
+        env_dir = temp_dir / "environment"
+        env_dir.mkdir()
+        (env_dir / "Dockerfile").write_text("FROM ubuntu:22.04\n")
+        if task_compose:
+            (env_dir / "docker-compose.yaml").write_text(
+                "services:\n  main:\n    image: ubuntu:22.04\n"
+            )
+        extra = []
+        if extra_compose:
+            overlay = temp_dir / "extra.yaml"
+            overlay.write_text("services:\n  main:\n    network_mode: none\n")
+            extra.append(overlay)
+        trial_paths = TrialPaths(trial_dir=temp_dir / "trial")
+        trial_paths.mkdir()
+        with patch.object(
+            DockerEnvironment, "_egress_control_kernel_support", return_value=False
+        ):
+            return DockerEnvironment(
+                environment_dir=env_dir,
+                environment_name="test-task",
+                session_id="test-task__abc123__env",
+                trial_paths=trial_paths,
+                task_env_config=EnvironmentConfig(
+                    docker_image="ubuntu:22.04", os=task_os
+                ),
+                network_policy=NetworkPolicy(network_mode=startup),
+                phase_network_policies=[
+                    NetworkPolicy(network_mode=phase) for phase in phases
+                ],
+                extra_docker_compose=extra,
+            )
+
+    @staticmethod
+    def _inspection_process(mode="none", *, returncode=0):
+        proc = Mock()
+        proc.returncode = returncode
+        proc.communicate = AsyncMock(
+            return_value=(
+                json.dumps(
+                    {
+                        "network_mode": mode,
+                        "image": "ubuntu:22.04",
+                        "image_id": "sha256:" + "b" * 64,
+                    }
+                ).encode(),
+                b"",
+            )
+        )
+        return proc
+
+    @pytest.mark.parametrize("phases", [(), (NetworkMode.NO_NETWORK,)])
+    def test_pure_offline_policy_has_only_static_capability(self, temp_dir, phases):
+        env = self._make_environment(temp_dir, phases=phases)
+        assert env._static_no_network is True
+        assert env._enable_egress_control is False
+        assert env.capabilities.disable_internet is True
+        assert env.capabilities.dynamic_network_policy is False
+        assert env.capabilities.network_allowlist is False
+        assert env.capabilities.network_allowlist_hostnames is False
+        assert env.capabilities.network_allowlist_ipv4_cidrs is False
+        assert env._docker_compose_paths[-1] == COMPOSE_NO_NETWORK_PATH
+        assert "network_mode: none" in COMPOSE_NO_NETWORK_PATH.read_text()
+        assert env._DOCKER_COMPOSE_EGRESS_CONTROL_PATH not in env._docker_compose_paths
+
+    def test_public_policy_does_not_gain_static_capability(self, temp_dir):
+        env = self._make_environment(
